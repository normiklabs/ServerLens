{
  "schemaVersion": 1,
  "id": "serverlens",
  "version": "${version}",
  "name": "ServerLens",
  "description": "A client-side mod that brings the full server preview (MOTD, ping, player count, and favicon) to the Direct-Connect Screen.",
  "authors": ["The normik Authors"],
  "contact": {
    "homepage": "https://modrinth.com/mod/serverlens",
    "sources": "https://github.com/normiklabs/ServerLens",
    "issues": "https://github.com/normiklabs/ServerLens/issues"
  },
  "entrypoints": {
    "client": [
      "org.normik.serverlens.Main"
    ]
  },
  "mixins": [
    "serverlens.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.3",
    "fabric-api": "*"
  },
  "license": "Apache-2.0",
  "icon": "icon.png"
}
